<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>org.allbinary</groupId>
    <artifactId>OpenGLESBaseJ2MEJavaLibraryAssemblyScript</artifactId>
    <!-- gl.gl OpenGLES Calls -->
    <packaging>jar</packaging>
    <!-- AllBinary Platform Version Start -->
    <version>1.0.0-SNAPSHOT</version>
    <!-- AllBinary Platform Version End -->

    <name>OpenGLESBaseJ2MEJavaLibraryAssemblyScript</name>
    <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>
    <properties>
        <cygwin.home>G:/cygwin64</cygwin.home>
        <planned.language>assemblyscript</planned.language>
        <planned.compiler>C:/assemblyscript/node_modules/assemblyscript/bin/asc.js</planned.compiler>
        <planned.compiler.flags></planned.compiler.flags>
        <planned.runtime.directory>G:/mnt/bc/mydev/workassemblyscript/j2me/J2SEForAssemblyScriptLibraryAssemblyScriptM/src/main/java</planned.runtime.directory>
        <planned.fail.on.error>true</planned.fail.on.error>
    </properties>




    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LoggingJ2MEAllAssemblyScript</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->

            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>LogJ2MEJavaLibraryAssemblyScript</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>OpenGLNoneJavaLibraryAssemblyScript</artifactId>
<!--   
            <artifactId>OpenGLNoneJavaLibraryAssemblyScript</artifactId>
            <artifactId>OpenGLJOGLJavaLibraryAssemblyScript</artifactId>
-->
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.allbinary</groupId>
            <artifactId>NullJ2MELibraryAssemblyScript</artifactId>
            <!-- AllBinary Platform Version Start -->
            <version>1.0.0-SNAPSHOT</version>
            <!-- AllBinary Platform Version End -->
            <optional>true</optional>
        </dependency>


        <dependency>
            <groupId>org.microemu</groupId>
            <artifactId>microemu-midp-for-polyglotAssemblyScript</artifactId>
            <version>2.0.4</version>
            <optional>true</optional>
        </dependency>

    </dependencies>

    <!-- Planned language build: PlannedLanguagePomBuildUpdater -->
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.8.1</version>
                <executions>
                    <execution>
                        <id>unpack-assemblyscript-dependencies</id>
                        <phase>generate-resources</phase>
                        <goals>
                            <goal>unpack-dependencies</goal>
                        </goals>
                        <configuration>
                            <includeScope>compile</includeScope>
                            <includeTypes>jar</includeTypes>
                            <excludeClassifiers>sources</excludeClassifiers>
                            <includes>META-INF/assemblyscript/**</includes>
                            <outputDirectory>${project.build.directory}/assemblyscript-dependencies</outputDirectory>
                            <overWriteSnapshots>true</overWriteSnapshots>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <executions>
                    <execution>
                        <id>compile-assemblyscript-sources</id>
                        <phase>compile</phase>
                        <goals>
                            <goal>exec</goal>
                        </goals>
                        <configuration>
                            <executable>${cygwin.home}/bin/bash.exe</executable>
                            <arguments>
                                <argument>${project.basedir}/build-cygwin.sh</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.outputDirectory}/META-INF/assemblyscript</argument>
                                <argument>${project.build.directory}/assemblyscript-objects</argument>
                                <argument>${project.build.directory}/assemblyscript-dependencies/META-INF/assemblyscript</argument>
                                <argument>${planned.runtime.directory}</argument>
                                <argument>${planned.compiler}</argument>
                                <argument>${planned.compiler.flags}</argument>
                                <argument>${project.artifactId}</argument>
                                <argument>${planned.fail.on.error}</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <version>3.3.1</version>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>

