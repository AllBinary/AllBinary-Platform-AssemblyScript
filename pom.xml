<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.allbinary</groupId>
  <artifactId>AllBinaryPlatformPOMAssemblyScript</artifactId>
  <packaging>pom</packaging>
  <!-- AllBinary Platform Version Start -->
  <version>1.0.0-SNAPSHOT</version>
  <!-- AllBinary Platform Version End -->

  <name>AllBinaryPlatformPOMAssemblyScript</name>
  <url>http://www.allbinary.com/</url>
    <distributionManagement>
        <snapshotRepository>
            <id>nexus-snapshots</id>
            <name>AllBinary Snapshots Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/snapshots/</url>
        </snapshotRepository>
        <repository>
            <id>nexus-releases</id>
            <name>AllBinary Releases Nexus</name>
            <url>https://nexus-allbinary.rhcloud.com/nexus/content/repositories/releases/</url>
        </repository>
    </distributionManagement>

    <properties>
        <buildLabel>${project.version}</buildLabel>
        <assemblyPluginVersion>2.2-beta-1</assemblyPluginVersion>
    </properties>

    <modules>

        <!--
        -->
        <module>./j2me/AllBinaryBaseLibraryPOAssemblyScriptM</module>
        <module>./j2me/AllBinaryJ2MELibraryAssemblyScriptP</module>
        <module>./AllBinaryPersistenceLibraryAssemblyScriptP</module>

        <!--<module>./automation/InputAutomationToolsAssemblyScriptP</module>-->
        <module>./graphics/GraphicsToolsAssemblyScriptP</module>
        <module>./allbinary_src/FreeblisketJavaLibraryAssemblyScriptP</module>
        <module>./j2me/games/platform/AllBinaryOnAllPlatformsJavaLibraryAssemblyScriptP</module>

        <!--
        <module>./j2me/media/graphics/animation/image/AllBinaryHTMLImageAnimationRotationJavaLibraryAssemblyScriptM</module>
        <module>./j2me/media/graphics/animation/image/AllBinaryHTML2ImageAnimationRotationJavaLibraryAssemblyScriptM</module>
        -->
        <!-- web language: no AWT/ImageIO <module>./j2me/media/graphics/animation/image/AllBinaryJ2SEImageAnimationRotationJavaLibraryAssemblyScriptM</module>-->
        <module>./j2me/games/Resources/sounds/release/GameSoundsJ2SEOggResourcesJavaLibraryAssemblyScriptM</module>
        <!-- web language: no JOGL <module>./graphics/opengl/AllBinaryJOGLResourcesJavaLibraryAssemblyScriptM</module>-->

    </modules>

    <dependencies>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>3.8.1</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

</project>

